{
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "prepare": "lerna run prepare",
    "start": "yarn workspace docs start",
    "build": "yarn workspace docs build",
    "test": "jest",
    "cover": "npx codecov"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@emotion/jest": "^11.14.2",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "^7.4.0",
    "lerna": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "resolutions": {
    "@mdx-js/react": "^1.5.5",
    "@babel/core": "^7.29.8",
    "@babel/helpers": "^7.29.8",
    "@babel/runtime": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "js-yaml@^3.13.1": "^3.15.2",
    "lodash": "^4.18.1",
    "minimatch@^3.0.4": "^3.1.5",
    "minimatch@^3.0.5": "^3.1.5",
    "minimatch@^3.1.1": "^3.1.5",
    "minimatch@^3.1.2": "^3.1.5",
    "minimist": "^1.2.8",
    "semver@^5.6.0": "^5.7.2",
    "semver@^5.7.1": "^5.7.2",
    "semver@^6.0.0": "^6.3.1",
    "semver@^6.3.1": "^6.3.1",
    "semver@^7.1.1": "^7.8.5",
    "semver@^7.2.1": "^7.8.5",
    "semver@^7.3.2": "^7.8.5",
    "semver@^7.3.4": "^7.8.5",
    "semver@^7.3.5": "^7.8.5",
    "semver@^7.3.7": "^7.8.5",
    "semver@^7.5.2": "^7.8.5",
    "semver@^7.5.3": "^7.8.5",
    "semver@^7.5.4": "^7.8.5",
    "semver@^7.6.3": "^7.8.5",
    "semver@^7.7.2": "^7.8.5",
    "semver@^7.8.5": "^7.8.5",
    "websocket-driver": "^0.7.5"
  },
  "jest": {
    "testMatch": [
      "**/packages/**/test/*.js"
    ],
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageReporters": [
      "lcov",
      "text",
      "html"
    ],
    "collectCoverageFrom": [
      "packages/**/src/*.js",
      "!packages/docs/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "setupFilesAfterEnv": [],
    "snapshotSerializers": [
      "@emotion/jest/serializer"
    ]
  }
}